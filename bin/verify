#!/usr/bin/env bash
# The single verification entry point for sunburntimer: one command, shared by
# contributors and CI. Run it before calling any change here done.
#
#   bin/verify
#   PWA_KIT_HOME=<path to the PWA toolkit> bin/verify   # adds the toolkit checks
#
# Three gates, in the order a failure is cheapest to read:
#
#   1. syntax        every file this app serves actually parses. The test suite
#                    imports the calculation core, but app.js and charts.js need
#                    a DOM and are never imported by it — without this a typo in
#                    the 1300-line UI module ships silently and the page is
#                    blank.
#   2. pwa_kit check optional, only where PWA_KIT_HOME points at the toolkit
#                    that generated the manifest and icons: pwa.json, the
#                    generated manifest and the icon set still agree, the
#                    maskable art still sits inside Android's crop circle, and
#                    index.html still carries the head block — the one part of
#                    the kit a human pastes, and therefore the one part that can
#                    be half-pasted. tests/sw.test.js then also checks that
#                    static/fleet_pwa.js is still a byte-identical copy of the
#                    toolkit's. Without the toolkit the gate says it skipped;
#                    tests/sw.test.js pins the head block and the worker from
#                    inside this repo either way.
#   3. tests/        node's built-in runner over the app's REAL modules: the
#                    honest-staleness rule, what the store persists, the service
#                    worker's invariants, and serve.py's delivery headers
#                    against a real subprocess on a scratch port.
#
# Runners, and why these: node ships its own test runner (`node --test`) and
# this app is browser ES modules, so the suite drives the same files the browser
# loads with no framework, no package to install and no build step — the repo
# has no dependencies and gains none here. serve.py is stdlib. node and python3
# are all it needs.
#
# What this canNOT check: the icon on a real home screen, and the headers a
# production deployment actually serves. With the toolkit, the second is
#
#   python3 "$PWA_KIT_HOME/bin/pwa_kit.py" check pwa.json --live https://<your host>
#
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== syntax =="
for file in js/*.js sw.js static/fleet_pwa.js tests/*.js bin/sun; do
    node --check "$file"
done
python3 -c "import ast,sys; ast.parse(open('serve.py').read())"
echo "ok"

echo "== pwa_kit check =="
if [ -n "${PWA_KIT_HOME:-}" ]; then
    PWA_KIT="$PWA_KIT_HOME/bin/pwa_kit.py"
    python3 "$PWA_KIT" check pwa.json
    python3 "$PWA_KIT" check pwa.json --html index.html
else
    echo "skip: PWA_KIT_HOME not set"
fi

echo "== tests =="
# The glob, not the directory: `node --test tests/` would treat tests/harness.js
# as a suite that declares no tests and fail on it.
node --test "tests/*.test.js"
